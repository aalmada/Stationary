<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:services="clr-namespace:Stationary.Ftms.Dashboard.Services;assembly=Stationary.Ftms.Dashboard.ViewModels"
             xmlns:local="clr-namespace:Stationary.Ftms.Dashboard"
             xmlns:core="clr-namespace:Stationary.Ftms.Dashboard.Core;assembly=Stationary.Ftms.Dashboard.Core"
             xmlns:viewModels="clr-namespace:Stationary.Ftms.Dashboard.ViewModels;assembly=Stationary.Ftms.Dashboard.ViewModels"
             x:Class="Stationary.Ftms.Dashboard.HeartRateSensorPage"
             x:DataType="viewModels:DashboardViewModel"
             Title="Heart-rate sensor"
             BackgroundColor="{StaticResource Canvas}">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <VerticalStackLayout Spacing="4">
          <Label Text="Bluetooth Heart Rate Service straps and watches. Optional, independent of the fitness machine." TextColor="{StaticResource Muted}" FontSize="14" />
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
          <ActivityIndicator IsRunning="{Binding IsWorking}" IsVisible="{Binding IsWorking}" Color="{StaticResource Accent}" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
        </HorizontalStackLayout>
      </Grid>

      <Border Background="{StaticResource SurfaceSubtle}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="12,8">
        <VerticalStackLayout Spacing="4">
          <Label Text="{Binding HeartRateConnectionStatus}" TextColor="{StaticResource Muted}" />
          <Label Text="{Binding OperationStatus}" TextColor="{StaticResource Muted}" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource PanelBorder}">
        <VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
              <Label Text="{Binding HeartRateChipText}" FontAttributes="Bold" />
              <Label Text="{Binding HeartRateChipDetail}" TextColor="{StaticResource Muted}" FontSize="12" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Style="{StaticResource ActionButton}" IsVisible="{Binding IsHeartRateConnected}" Text="Disconnect" Command="{Binding DisconnectHeartRateCommand}" IsEnabled="{Binding CanInitiateOperation}" SemanticProperties.Description="Disconnect the heart-rate sensor" />
            <Button Grid.Column="1" Style="{StaticResource ActionButton}" IsVisible="{Binding IsHeartRateDisconnected}" Text="Find sensor" Command="{Binding ScanHeartRateCommand}" IsEnabled="{Binding CanInitiateOperation}" SemanticProperties.Description="Search for Bluetooth heart-rate sensors" />
          </Grid>

          <VerticalStackLayout Spacing="8" IsVisible="{Binding IsHeartRateDevicePickerVisible}">
            <Label Text="Nearby heart-rate sensors" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding HeartRateDiscoveredDevices}" SelectionMode="Single" SelectedItem="{Binding SelectedHeartRateDevice, Mode=OneWay}" local:ReactiveInput.SelectionChangedCommand="{Binding SelectHeartRateDeviceCommand}" HeightRequest="160">
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:HeartRateDiscoveredDevice">
                  <Label Text="{Binding Name}" Padding="8" FontAttributes="Bold" />
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
            <HorizontalStackLayout Spacing="12">
              <Button Style="{StaticResource ActionButton}" Text="Scan again" Command="{Binding ScanHeartRateCommand}" IsEnabled="{Binding CanInitiateOperation}" SemanticProperties.Description="Search again for Bluetooth heart-rate sensors" />
              <Button Style="{StaticResource ActionButton}" Text="Connect selected" Command="{Binding ConnectHeartRateCommand}" IsEnabled="{Binding CanInitiateOperation}" SemanticProperties.Description="Connect the selected heart-rate sensor" />
            </HorizontalStackLayout>
          </VerticalStackLayout>
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource PanelBorder}">
        <VerticalStackLayout Spacing="8">
          <Label Text="HEART-RATE ZONES" FontAttributes="Bold" />
          <Label Text="Choose a method. Measured values are more personal than age estimates; heart rate can be affected by medication, illness, heat and fatigue." TextColor="{StaticResource Muted}" FontSize="12" />
          <Label Text="{Binding HeartRate.SelectedZoneMethod, StringFormat='Active method: {0}'}" TextColor="{StaticResource Muted}" FontSize="11" />
          <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start">
            <Button Style="{StaticResource SecondaryActionButton}" Text="Cycling LTHR" Command="{Binding HeartRate.SelectZoneMethodCommand}" CommandParameter="{x:Static core:HeartRateZoneMethod.CyclingLactateThreshold}" />
            <Button Style="{StaticResource SecondaryActionButton}" Text="Heart-rate reserve" Command="{Binding HeartRate.SelectZoneMethodCommand}" CommandParameter="{x:Static core:HeartRateZoneMethod.HeartRateReserve}" />
            <Button Style="{StaticResource SecondaryActionButton}" Text="Maximum heart rate" Command="{Binding HeartRate.SelectZoneMethodCommand}" CommandParameter="{x:Static core:HeartRateZoneMethod.MaximumHeartRate}" />
          </FlexLayout>
          <Grid ColumnDefinitions="Auto,100,Auto,100" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
            <Label Text="CYCLING LTHR" FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            <Border Grid.Column="1" Background="{StaticResource SurfaceSubtle}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 5" Padding="8,0">
              <Entry Text="{Binding HeartRate.LactateThresholdText, Mode=OneWay}" local:ReactiveInput.TextChangedCommand="{Binding HeartRate.EditLactateThresholdCommand}" TextColor="{StaticResource Ink}" PlaceholderColor="{StaticResource Muted}" Keyboard="Numeric" Placeholder="bpm" HorizontalTextAlignment="Center" SemanticProperties.Description="Cycling lactate threshold heart rate in beats per minute" />
            </Border>
            <Label Grid.Column="2" Text="MAX HR" FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            <Border Grid.Column="3" Background="{StaticResource SurfaceSubtle}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 5" Padding="8,0">
              <Entry Text="{Binding HeartRate.MaximumHeartRateText, Mode=OneWay}" local:ReactiveInput.TextChangedCommand="{Binding HeartRate.EditMaximumHeartRateCommand}" TextColor="{StaticResource Ink}" PlaceholderColor="{StaticResource Muted}" Keyboard="Numeric" Placeholder="bpm" HorizontalTextAlignment="Center" SemanticProperties.Description="Measured or estimated maximum heart rate" />
            </Border>
            <Label Grid.Row="1" Text="RESTING HR" FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceSubtle}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 5" Padding="8,0">
              <Entry Text="{Binding HeartRate.RestingHeartRateText, Mode=OneWay}" local:ReactiveInput.TextChangedCommand="{Binding HeartRate.EditRestingHeartRateCommand}" TextColor="{StaticResource Ink}" PlaceholderColor="{StaticResource Muted}" Keyboard="Numeric" Placeholder="bpm" HorizontalTextAlignment="Center" SemanticProperties.Description="Resting heart rate for heart-rate-reserve zones" />
            </Border>
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryActionButton}" Text="Estimate max from age" Command="{Binding HeartRate.EstimateMaximumHeartRateCommand}" />
            <Border Grid.Row="1" Grid.Column="3" Background="{StaticResource SurfaceSubtle}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 5" Padding="8,0">
              <Entry Text="{Binding HeartRate.AgeText, Mode=OneWay}" local:ReactiveInput.TextChangedCommand="{Binding HeartRate.EditAgeCommand}" TextColor="{StaticResource Ink}" PlaceholderColor="{StaticResource Muted}" Keyboard="Numeric" Placeholder="age" HorizontalTextAlignment="Center" SemanticProperties.Description="Age used only for a maximum heart-rate estimate" />
            </Border>
          </Grid>
          <Label Text="{Binding HeartRate.MaximumHeartRateEstimateText}" TextColor="{StaticResource Muted}" FontSize="11" />
          <Grid ColumnDefinitions="Auto,100,*,Auto" ColumnSpacing="8">
            <Label Text="OPTIONAL CEILING" FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            <Border Grid.Column="1" Background="{StaticResource SurfaceSubtle}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 5" Padding="8,0">
              <Entry Text="{Binding HeartRate.SafetyCeilingText, Mode=OneWay}" local:ReactiveInput.TextChangedCommand="{Binding HeartRate.EditSafetyCeilingCommand}" TextColor="{StaticResource Ink}" PlaceholderColor="{StaticResource Muted}" Keyboard="Numeric" Placeholder="bpm" HorizontalTextAlignment="Center" SemanticProperties.Description="Optional heart-rate ceiling for power-based workouts" />
            </Border>
            <Button Grid.Column="3" Style="{StaticResource ActionButton}" Text="Apply zones" Command="{Binding ApplyHeartRateZonesCommand}" SemanticProperties.Description="Apply the selected heart-rate zone method and optional ceiling" />
          </Grid>
          <Label Text="Age-based maximum heart rate is only an estimate and can be substantially wrong for an individual. Ask a clinician for individualized targets if you have a heart condition, an irregular rhythm, a pacemaker, or take medicine that changes heart rate." TextColor="{StaticResource Muted}" FontSize="11" />
        </VerticalStackLayout>
      </Border>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
