<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:local="clr-namespace:Stationary.Ftms.Dashboard"
             xmlns:core="clr-namespace:Stationary.Ftms.Dashboard.Core;assembly=Stationary.Ftms.Dashboard.Core"
             xmlns:viewModels="clr-namespace:Stationary.Ftms.Dashboard.ViewModels;assembly=Stationary.Ftms.Dashboard.ViewModels"
             x:Class="Stationary.Ftms.Dashboard.ScenePage"
             x:DataType="viewModels:RideSceneViewModel"
             Title="Stationary Ride Scene"
             BackgroundColor="#05030C">
  <ContentPage.Resources>
    <local:HeartRateZoneColorConverter x:Key="ZoneColor" />
    <Style x:Key="HudPanel" TargetType="Border">
      <Setter Property="BackgroundColor" Value="#B305060F" />
      <Setter Property="Stroke" Value="#1AEBFF" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="Shadow">
        <Shadow Brush="#1AEBFF" Radius="18" Opacity="0.55" Offset="0,0" />
      </Setter>
      <Setter Property="StrokeShape" Value="RoundRectangle 14" />
      <Setter Property="Padding" Value="18,12" />
    </Style>
    <Style x:Key="HudText" TargetType="Label">
      <Setter Property="TextColor" Value="White" />
      <Setter Property="FontSize" Value="16" />
    </Style>
  </ContentPage.Resources>
  <Grid>
    <local:RideSceneView x:Name="SceneView" SceneFrame="{Binding Frame}" />

    <Grid Padding="24" RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto" InputTransparent="True" CascadeInputTransparent="True">
      <!-- Ride progress: elapsed time, distance and the next distance and time milestones. -->
      <Border Style="{StaticResource HudPanel}" VerticalOptions="Start" WidthRequest="300">
        <VerticalStackLayout Spacing="4">
          <Label Text="RIDE" Style="{StaticResource HudText}" FontSize="12" Opacity="0.7" CharacterSpacing="2" />
          <Label Text="{Binding ElapsedText}" Style="{StaticResource HudText}" FontSize="44" FontAttributes="Bold" />
          <Label Text="{Binding DistanceText}" Style="{StaticResource HudText}" FontSize="24" TextColor="#1AEBFF" FontAttributes="Bold" />
          <Label Text="{Binding NextDistanceText}" Style="{StaticResource HudText}" FontSize="13" Opacity="0.85" Margin="0,8,0,0" />
          <ProgressBar Progress="{Binding NextDistanceProgress}" ProgressColor="#1AEBFF" />
          <Label Text="{Binding NextTimeText}" Style="{StaticResource HudText}" FontSize="13" Opacity="0.85" Margin="0,6,0,0" />
          <ProgressBar Progress="{Binding NextTimeProgress}" ProgressColor="#FF29C7" />
          <Label Text="{Binding StreakText}" Style="{StaticResource HudText}" FontSize="13" Opacity="0.85" Margin="0,6,0,0">
            <Label.Triggers>
              <DataTrigger TargetType="Label" Binding="{Binding StreakText}" Value="">
                <Setter Property="IsVisible" Value="False" />
              </DataTrigger>
            </Label.Triggers>
          </Label>
        </VerticalStackLayout>
      </Border>

      <!-- Target status, medals and achievement count. -->
      <VerticalStackLayout Grid.Column="2" Spacing="10" HorizontalOptions="End" VerticalOptions="Start">
        <Border Style="{StaticResource HudPanel}" Stroke="#5973BF" HorizontalOptions="End">
          <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="{x:Static core:RideGameTargetStatus.OnTarget}">
              <Setter Property="Stroke" Value="#1AF2FF" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="{x:Static core:RideGameTargetStatus.Riding}">
              <Setter Property="Stroke" Value="#4080FF" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="{x:Static core:RideGameTargetStatus.TooLow}">
              <Setter Property="Stroke" Value="#FF9E1A" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="{x:Static core:RideGameTargetStatus.TooHigh}">
              <Setter Property="Stroke" Value="#FF1F40" />
            </DataTrigger>
          </Border.Triggers>
          <Label Text="{Binding StatusText}" Style="{StaticResource HudText}" FontSize="20" FontAttributes="Bold" />
        </Border>
        <Border Style="{StaticResource HudPanel}" HorizontalOptions="End">
          <VerticalStackLayout Spacing="2">
            <Label Text="{Binding MedalsText}" Style="{StaticResource HudText}" FontSize="22" />
            <Label Text="{Binding AchievementCountText}" Style="{StaticResource HudText}" FontSize="13" Opacity="0.75" HorizontalOptions="End" />
          </VerticalStackLayout>
        </Border>
      </VerticalStackLayout>

      <!-- The latest achievements, newest first. -->
      <Border Grid.Row="1" Style="{StaticResource HudPanel}" Stroke="#FF29C7" VerticalOptions="Start" Margin="0,16,0,0" WidthRequest="300">
        <Border.Shadow>
          <Shadow Brush="#FF29C7" Radius="18" Opacity="0.5" Offset="0,0" />
        </Border.Shadow>
        <Border.Triggers>
          <DataTrigger TargetType="Border" Binding="{Binding AchievementCountText}" Value="0 achievements">
            <Setter Property="IsVisible" Value="False" />
          </DataTrigger>
        </Border.Triggers>
        <VerticalStackLayout Spacing="6">
          <Label Text="ACHIEVEMENTS" Style="{StaticResource HudText}" FontSize="12" Opacity="0.7" CharacterSpacing="2" />
          <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding RecentAchievements}">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Label Text="{Binding .}" Style="{StaticResource HudText}" FontSize="15" LineBreakMode="TailTruncation" />
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        </VerticalStackLayout>
      </Border>

      <!-- Achievement toast. -->
      <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource HudPanel}" Stroke="#FF29C7"
              HorizontalOptions="Center" VerticalOptions="Start" Margin="0,24,0,0" Padding="28,16"
              IsVisible="{Binding IsAchievementVisible}">
        <Label Text="{Binding AchievementText}" Style="{StaticResource HudText}" FontSize="28" FontAttributes="Bold" />
      </Border>

      <!-- Bottom bar: heart rate and zone ladder, the current interval, and live metrics. -->
      <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <Border Style="{StaticResource HudPanel}" Stroke="{Binding HeartRateZoneIndex, Converter={StaticResource ZoneColor}}" VerticalOptions="End">
          <VerticalStackLayout Spacing="8">
            <HorizontalStackLayout Spacing="10">
              <Label Text="♥" Style="{StaticResource HudText}" FontSize="30" TextColor="{Binding HeartRateZoneIndex, Converter={StaticResource ZoneColor}}" VerticalOptions="Center" />
              <Label Text="{Binding HeartRateText}" Style="{StaticResource HudText}" FontSize="40" FontAttributes="Bold" VerticalOptions="Center" />
              <VerticalStackLayout VerticalOptions="Center">
                <Label Text="BPM" Style="{StaticResource HudText}" FontSize="12" Opacity="0.7" CharacterSpacing="2" />
                <Label Text="{Binding HeartRateZoneText}" Style="{StaticResource HudText}" FontSize="14"
                       TextColor="{Binding HeartRateZoneIndex, Converter={StaticResource ZoneColor}}" />
              </VerticalStackLayout>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Zones}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="viewModels:RideSceneZone">
                  <Border StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="8,4" Opacity="0.4" WidthRequest="64"
                          BackgroundColor="{Binding ., Converter={StaticResource ZoneColor}}">
                    <Border.Triggers>
                      <DataTrigger TargetType="Border" Binding="{Binding IsTarget}" Value="True">
                        <Setter Property="Opacity" Value="0.7" />
                        <Setter Property="Stroke" Value="White" />
                        <Setter Property="StrokeThickness" Value="1" />
                      </DataTrigger>
                      <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Stroke" Value="White" />
                        <Setter Property="StrokeThickness" Value="2.5" />
                        <Setter Property="Scale" Value="1.08" />
                      </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout>
                      <Label Text="{Binding Code}" TextColor="#05060F" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                      <Label Text="{Binding RangeText}" TextColor="#05060F" FontSize="10" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                  </Border>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
          </VerticalStackLayout>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource HudPanel}" HorizontalOptions="Center" VerticalOptions="End">
          <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IntervalText}" Value="">
              <Setter Property="IsVisible" Value="False" />
            </DataTrigger>
          </Border.Triggers>
          <Label Text="{Binding IntervalText}" Style="{StaticResource HudText}" FontSize="18" />
        </Border>

        <Border Grid.Column="2" Style="{StaticResource HudPanel}" VerticalOptions="End">
          <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding MetricsText}" Value="">
              <Setter Property="IsVisible" Value="False" />
            </DataTrigger>
          </Border.Triggers>
          <Label Text="{Binding MetricsText}" Style="{StaticResource HudText}" FontSize="20" FontAttributes="Bold" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</ContentPage>
