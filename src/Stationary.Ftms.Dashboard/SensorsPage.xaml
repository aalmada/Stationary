<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:local="clr-namespace:Stationary.Ftms.Dashboard;assembly=Stationary.Ftms.Dashboard.ViewModels"
             xmlns:services="clr-namespace:Stationary.Ftms.Dashboard.Services;assembly=Stationary.Ftms.Dashboard.ViewModels"
             xmlns:viewModels="clr-namespace:Stationary.Ftms.Dashboard.ViewModels;assembly=Stationary.Ftms.Dashboard.ViewModels"
             x:Class="Stationary.Ftms.Dashboard.SensorsPage"
             x:DataType="viewModels:DashboardViewModel"
             Title="Fitness machine"
             BackgroundColor="{StaticResource Canvas}">
  <Grid x:Name="PageLayout">
    <ScrollView>
      <Grid x:Name="ContentGrid" Padding="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
      <Grid x:Name="SensorsHeader" ColumnDefinitions="*,Auto">
        <VerticalStackLayout Spacing="4">
          <Label Text="Smart trainers and bikes using the Bluetooth Fitness Machine Service (FTMS)." TextColor="{StaticResource Muted}" FontSize="14" />
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
          <ActivityIndicator IsRunning="{Binding IsWorking}" IsVisible="{Binding IsWorking}" Color="{StaticResource Accent}" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
        </HorizontalStackLayout>
      </Grid>

      <Border x:Name="StatusPanel" Grid.Row="1" Background="{StaticResource SurfaceSubtle}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="12,8">
        <Label Text="{Binding StatusText}" TextColor="{StaticResource Muted}" />
      </Border>

      <Border x:Name="FitnessMachinePanel" Grid.Row="2" Style="{StaticResource PanelBorder}">
        <VerticalStackLayout Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
              <Label Text="Fitness machine" FontAttributes="Bold" />
              <Label Text="{Binding MachineChipDetail}" TextColor="{StaticResource Muted}" FontSize="12" IsVisible="{Binding IsConnected}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Style="{StaticResource ActionButton}" IsVisible="{Binding IsDisconnected}" Text="Find machine" Command="{Binding ScanCommand}" IsEnabled="{Binding CanInitiateOperation}" SemanticProperties.Description="Search for nearby FTMS fitness machines" />
            <Button Grid.Column="1" Style="{StaticResource ActionButton}" IsVisible="{Binding IsConnected}" Text="Disconnect" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanInitiateOperation}" SemanticProperties.Description="Disconnect from the active fitness machine" />
          </Grid>

          <VerticalStackLayout Spacing="12" IsVisible="{Binding IsDevicePickerVisible}">
            <Label Text="Nearby FTMS devices" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding DiscoveredDevices}" SelectionMode="Single" SelectedItem="{Binding SelectedDevice}" HeightRequest="168">
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:FtmsDiscoveredDevice">
                  <VerticalStackLayout Padding="8" Spacing="2">
                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                    <Label Text="{Binding MachineType}" TextColor="{StaticResource Muted}" />
                  </VerticalStackLayout>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
            <HorizontalStackLayout Spacing="12">
              <Button Style="{StaticResource ActionButton}" Text="Scan again" Command="{Binding ScanCommand}" IsEnabled="{Binding CanInitiateOperation}" SemanticProperties.Description="Search again for nearby FTMS fitness machines" />
              <Button Style="{StaticResource ActionButton}" Text="Connect selected" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanInitiateOperation}" SemanticProperties.Description="Connect to the selected fitness machine" />
            </HorizontalStackLayout>
          </VerticalStackLayout>
        </VerticalStackLayout>
      </Border>

      <Border x:Name="DeviceCapabilitiesPanel" Grid.Row="3" Style="{StaticResource PanelBorder}" IsVisible="{Binding IsConnected}">
        <VerticalStackLayout Spacing="8">
          <Label Text="Device capabilities" FontAttributes="Bold" />
          <Label Text="Live now" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource Muted}" />
          <FlexLayout BindableLayout.ItemsSource="{Binding LiveCapabilities}" Direction="Row" Wrap="Wrap" AlignItems="Start">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="local:DeviceCapability">
                <VerticalStackLayout Margin="0,0,16,10" Spacing="1">
                  <Label Text="{Binding Name}" FontAttributes="Bold" />
                  <Label Text="{Binding Status}" FontSize="12" TextColor="{StaticResource Muted}">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding IsNotProvided}" Value="True">
                        <Setter Property="TextColor" Value="#B42318" />
                        <Setter Property="FontAttributes" Value="Bold" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                </VerticalStackLayout>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>
          <Label Text="Available controls" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource Muted}" />
          <FlexLayout BindableLayout.ItemsSource="{Binding AvailableControlCapabilities}" Direction="Row" Wrap="Wrap" AlignItems="Start">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="local:DeviceCapability">
                <Label Text="{Binding Name}" Margin="0,0,16,8" />
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>
          <Button Text="Unavailable telemetry" TextColor="{StaticResource Accent}" HorizontalOptions="Start" Padding="0" Command="{Binding ToggleUnavailableCapabilitiesCommand}" />
          <FlexLayout BindableLayout.ItemsSource="{Binding UnavailableCapabilities}" Direction="Row" Wrap="Wrap" AlignItems="Start" IsVisible="{Binding ShowUnavailableCapabilities}">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="local:DeviceCapability">
                <VerticalStackLayout Margin="0,0,16,10" Spacing="1">
                  <Label Text="{Binding Name}" FontAttributes="Bold" />
                  <Label Text="{Binding Status}" FontSize="12" TextColor="#B42318" />
                </VerticalStackLayout>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>
        </VerticalStackLayout>
      </Border>
      </Grid>
    </ScrollView>
  </Grid>
</ContentPage>