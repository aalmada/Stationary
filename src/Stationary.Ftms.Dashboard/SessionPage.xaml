<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Stationary.Ftms.Dashboard"
             xmlns:viewModels="clr-namespace:Stationary.Ftms.Dashboard.ViewModels"
             x:Class="Stationary.Ftms.Dashboard.SessionPage"
             x:DataType="viewModels:DashboardViewModel"
             Title="Session"
             BackgroundColor="{StaticResource Canvas}">
  <Grid x:Name="PageLayout">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1100" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter TargetName="ContentGrid" Property="ColumnDefinitions" Value="2*,3*" />
            <Setter TargetName="ContentGrid" Property="RowDefinitions" Value="Auto,Auto,*" />
            <Setter TargetName="ContentGrid" Property="ColumnSpacing" Value="16" />
            <Setter TargetName="SessionHeader" Property="Grid.ColumnSpan" Value="2" />
            <Setter TargetName="SessionUnavailablePanel" Property="Grid.ColumnSpan" Value="2" />
            <Setter TargetName="TelemetryColumn" Property="Grid.Column" Value="1" />
            <Setter TargetName="TelemetryColumn" Property="Grid.Row" Value="2" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <ScrollView x:Name="PageScroll">
      <Grid x:Name="ContentGrid" Padding="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16" MinimumHeightRequest="{Binding Source={x:Reference PageScroll}, Path=Height}">
      <Grid x:Name="SessionHeader" ColumnDefinitions="*,Auto">
        <VerticalStackLayout Spacing="4">
          <Label Text="SESSION" FontAttributes="Bold" FontSize="30" />
          <Label Text="Workout totals and detailed telemetry" TextColor="{StaticResource Muted}" FontSize="14" />
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center" IsVisible="{Binding IsSessionAvailable}">
          <Button Text="{Binding StartActionText}" TextColor="{StaticResource Accent}" Padding="4" Command="{Binding StartCommand}" IsVisible="{Binding IsControllable}" />
          <Button Text="Pause" TextColor="{StaticResource Accent}" Padding="4" Command="{Binding StopCommand}" IsVisible="{Binding IsControllable}" />
          <Button Text="Lap" TextColor="{StaticResource Accent}" Padding="4" Command="{Binding AddLapCommand}" SemanticProperties.Description="Mark a lap at the current session time" />
          <Button Text="Reset" TextColor="{StaticResource Accent}" Padding="4" Command="{Binding ResetSessionCommand}" SemanticProperties.Description="Reset locally tracked session totals" />
          <Button Text="Export CSV" TextColor="{StaticResource Accent}" Padding="4" Command="{Binding ExportSessionCommand}" SemanticProperties.Description="Export synchronized telemetry, events, and session metrics as CSV" />
        </HorizontalStackLayout>
      </Grid>

      <Border x:Name="SessionUnavailablePanel" Grid.Row="1" Background="{StaticResource SurfaceSubtle}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="12,8" IsVisible="{Binding IsSessionUnavailable}">
        <Label Text="Connect a fitness machine or heart-rate sensor to begin a session." TextColor="{StaticResource Muted}" />
      </Border>

      <Grid x:Name="SessionOverviewColumn" Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16" HorizontalOptions="Fill">
      <Border x:Name="SessionSummaryPanel" Grid.Row="0" Style="{StaticResource PanelBorder}" IsVisible="{Binding IsSessionAvailable}">
        <VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
              <Label Text="Session summary" FontAttributes="Bold" />
              <Label Text="Current power" FontSize="12" TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Label Grid.Column="1" Text="{Binding Telemetry.PowerText}" FontSize="{Binding Telemetry.HeartRateValueFontSize}" FontAttributes="Bold" VerticalOptions="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
            <VerticalStackLayout Spacing="2">
              <Label Text="Distance" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionDistanceText}" FontSize="{Binding Telemetry.SessionMetricValueFontSize}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="Elapsed" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionElapsedTimeText}" FontSize="{Binding Telemetry.SessionMetricValueFontSize}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="2">
              <Label Text="Energy" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionEnergyText}" FontSize="{Binding Telemetry.SessionMetricValueFontSize}" FontAttributes="Bold" />
            </VerticalStackLayout>
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
            <VerticalStackLayout Grid.ColumnSpan="2" Spacing="2">
              <Label Text="Session average power" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionAveragePowerText}" FontSize="{Binding Telemetry.SessionMetricValueFontSize}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Grid.ColumnSpan="2" Spacing="2">
              <Label Text="Session maximum power" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionMaximumPowerText}" FontSize="{Binding Telemetry.SessionMetricValueFontSize}" FontAttributes="Bold" />
            </VerticalStackLayout>
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
            <VerticalStackLayout Spacing="2">
              <Label Text="Work" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionWorkText}" FontSize="{Binding Telemetry.SessionMetricValueFontSize}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="Normalized power" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.NormalizedPowerText}" FontSize="{Binding Telemetry.SessionMetricValueFontSize}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="2">
              <Label Text="Intensity factor" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.IntensityFactorText}" FontSize="{Binding Telemetry.SessionMetricValueFontSize}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" Spacing="2">
              <Label Text="TSS" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.TrainingStressScoreText}" FontSize="{Binding Telemetry.SessionMetricValueFontSize}" FontAttributes="Bold" />
            </VerticalStackLayout>
          </Grid>
          <Label Text="{Binding Telemetry.PeakPowerText}" FontSize="11" TextColor="{StaticResource Muted}" />
          <Label Text="{Binding PreviousSessionComparisonText}" FontSize="11" TextColor="{StaticResource Muted}" />
        </VerticalStackLayout>
      </Border>

      <Border x:Name="HeartRatePanel" Grid.Row="1" Style="{StaticResource PanelBorder}" IsVisible="{Binding IsHeartRateConnected}">
        <VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
              <Label Text="External heart rate" FontAttributes="Bold" />
              <Label Text="{Binding HeartRate.HealthText}" FontSize="12" TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Label Grid.Column="1" Text="{Binding HeartRate.CurrentHeartRateText}" FontSize="{Binding Telemetry.HeartRateValueFontSize}" FontAttributes="Bold" VerticalOptions="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
            <VerticalStackLayout Spacing="2">
              <Label Text="CURRENT ZONE" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding HeartRate.CurrentZoneText}" FontAttributes="Bold" />
              <Label Text="{Binding HeartRate.CurrentZoneRangeText}" FontSize="11" TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="SESSION AVERAGE" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding HeartRate.SessionAverageText}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="2">
              <Label Text="SESSION MAXIMUM" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding HeartRate.SessionMaximumText}" FontAttributes="Bold" />
            </VerticalStackLayout>
          </Grid>
          <FlexLayout BindableLayout.ItemsSource="{Binding HeartRate.ZoneDurations}" Direction="Row" Wrap="Wrap" AlignItems="Start" IsVisible="{Binding HeartRate.IsZoneProfileConfigured}">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="viewModels:HeartRateZoneViewModel">
                <Grid Margin="0,0,20,4" ColumnDefinitions="6,Auto" ColumnSpacing="7">
                  <Border Background="{Binding ZoneColor}" StrokeThickness="0" StrokeShape="RoundRectangle 2" />
                  <VerticalStackLayout Grid.Column="1" Spacing="1">
                  <HorizontalStackLayout Spacing="6">
                    <Label Text="{Binding Code}" TextColor="{StaticResource Muted}" FontSize="12">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Accent}" />
                        <Setter Property="FontAttributes" Value="Bold" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                    <Label Text="{Binding PercentageText}" TextColor="{StaticResource Muted}" FontSize="12" />
                  </HorizontalStackLayout>
                  <Label Text="{Binding TimeInZoneText}" FontAttributes="Bold" />
                  <Label Text="{Binding RangeText}" TextColor="{StaticResource Muted}" FontSize="11" />
                  </VerticalStackLayout>
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>
        </VerticalStackLayout>
      </Border>

      <Border x:Name="DisplaySettingsPanel" Grid.Row="3" Style="{StaticResource PanelBorder}" HorizontalOptions="Fill">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <Label Text="Display options" FontAttributes="Bold" />
          <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="20">
            <VerticalStackLayout Spacing="4">
              <Label Text="Metric units" FontAttributes="Bold" />
              <Label Text="Speed and distance" FontSize="12" TextColor="{StaticResource Muted}" />
              <local:ReactiveSwitch IsToggled="{Binding Telemetry.UseMetricUnits, Mode=OneWay}" ToggledCommand="{Binding Telemetry.SetMetricUnitsCommand}" OnColor="{StaticResource Accent}" HorizontalOptions="Start" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="4">
              <Label Text="Large values" FontAttributes="Bold" />
              <Label Text="Session and Ride metrics" FontSize="12" TextColor="{StaticResource Muted}" />
              <local:ReactiveSwitch IsToggled="{Binding Telemetry.UseLargeTelemetryText, Mode=OneWay}" ToggledCommand="{Binding Telemetry.SetLargeTelemetryTextCommand}" OnColor="{StaticResource Accent}" HorizontalOptions="Start" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="4">
              <Label Text="High contrast" FontAttributes="Bold" />
              <Label Text="Charts and guides" FontSize="12" TextColor="{StaticResource Muted}" />
              <local:ReactiveSwitch IsToggled="{Binding Telemetry.UseHighContrastTelemetry, Mode=OneWay}" ToggledCommand="{Binding Telemetry.SetHighContrastTelemetryCommand}" OnColor="{StaticResource Accent}" HorizontalOptions="Start" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" Spacing="4">
              <Label Text="Compact charts" FontAttributes="Bold" />
              <Label Text="Hide side summaries" FontSize="12" TextColor="{StaticResource Muted}" />
              <local:ReactiveSwitch IsToggled="{Binding Telemetry.UseCompactCharts, Mode=OneWay}" ToggledCommand="{Binding Telemetry.SetCompactChartsCommand}" OnColor="{StaticResource Accent}" HorizontalOptions="Start" />
            </VerticalStackLayout>
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,100,Auto,*" ColumnSpacing="8">
            <Label Text="Cycling FTP" FontAttributes="Bold" VerticalOptions="Center" />
            <Entry Grid.Column="1" Text="{Binding Telemetry.FunctionalThresholdPowerText}" Keyboard="Numeric" Placeholder="watts" />
            <Button Grid.Column="2" Text="Apply" Command="{Binding Telemetry.ApplyFunctionalThresholdPowerCommand}" Padding="12,6" />
            <Label Grid.Column="3" Text="Enables power zones, intensity factor, and training stress score." FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="TelemetryAnalysisPanel" Grid.Row="2" Style="{StaticResource PanelBorder}" IsVisible="{Binding IsSessionAvailable}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
          <Label Text="Analysis" FontAttributes="Bold" />
          <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
            <VerticalStackLayout Spacing="2">
              <Label Text="{Binding Telemetry.TorqueResponseInsight.Name}" TextColor="{StaticResource Muted}" FontSize="12" />
              <Label Text="{Binding Telemetry.TorqueResponseInsight.Value}" FontAttributes="Bold" />
              <Label Text="{Binding Telemetry.TorqueResponseInsight.Detail}" TextColor="{StaticResource Muted}" FontSize="11" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="{Binding Telemetry.PowerPacingInsight.Name}" TextColor="{StaticResource Muted}" FontSize="12" />
              <Label Text="{Binding Telemetry.PowerPacingInsight.Value}" FontAttributes="Bold" />
              <Label Text="{Binding Telemetry.PowerPacingInsight.Detail}" TextColor="{StaticResource Muted}" FontSize="11" />
            </VerticalStackLayout>
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
            <VerticalStackLayout Spacing="2">
              <Label Text="{Binding Telemetry.SpeedTrendInsight.Name}" TextColor="{StaticResource Muted}" FontSize="12" />
              <Label Text="{Binding Telemetry.SpeedTrendInsight.Value}" FontAttributes="Bold" />
              <Label Text="{Binding Telemetry.SpeedTrendInsight.Detail}" TextColor="{StaticResource Muted}" FontSize="11" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="{Binding Telemetry.CadenceConsistencyInsight.Name}" TextColor="{StaticResource Muted}" FontSize="12" />
              <Label Text="{Binding Telemetry.CadenceConsistencyInsight.Value}" FontAttributes="Bold" />
              <Label Text="{Binding Telemetry.CadenceConsistencyInsight.Detail}" TextColor="{StaticResource Muted}" FontSize="11" />
            </VerticalStackLayout>
          </Grid>
          <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="16">
            <VerticalStackLayout Spacing="2">
              <Label Text="Power / HR efficiency" TextColor="{StaticResource Muted}" FontSize="12" />
              <Label Text="{Binding EfficiencyText}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="Aerobic decoupling" TextColor="{StaticResource Muted}" FontSize="12" />
              <Label Text="{Binding DecouplingText}" FontAttributes="Bold" />
            </VerticalStackLayout>
          </Grid>
          <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="16">
            <VerticalStackLayout Spacing="2">
              <Label Text="HR recovery" TextColor="{StaticResource Muted}" FontSize="12" />
              <Label Text="{Binding RecoveryText}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="Cadence range" TextColor="{StaticResource Muted}" FontSize="12" />
              <Label Text="{Binding CadenceAnalysisText}" FontAttributes="Bold" />
            </VerticalStackLayout>
          </Grid>
          <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="16">
            <VerticalStackLayout Spacing="2">
              <Label Text="Low-cadence high-torque" TextColor="{StaticResource Muted}" FontSize="12" />
              <Label Text="{Binding TorqueExposureText}" FontAttributes="Bold" />
            </VerticalStackLayout>
          </Grid>
        </Grid>
      </Border>
      </Grid>

      <Grid x:Name="TelemetryColumn" Grid.Row="3" HorizontalOptions="Fill" VerticalOptions="Fill">
      <Border x:Name="TelemetryHistoryPanel" Style="{StaticResource PanelBorder}" IsVisible="{Binding IsSessionAvailable}" VerticalOptions="Fill">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
              <Label Text="Telemetry history" FontAttributes="Bold" />
              <Label Text="{Binding SelectedIntervalSummary}" FontSize="11" TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="8">
              <Button Text="Zoom selection" Command="{Binding ZoomToSelectionCommand}" Padding="10,4" />
              <Button Text="Live 5m" Command="{Binding ResetChartZoomCommand}" Padding="10,4" />
            </HorizontalStackLayout>
          </Grid>
          <Grid Grid.Row="1" RowDefinitions="*,*,*,*,1.75*" RowSpacing="8" MinimumHeightRequest="420" VerticalOptions="Fill">
            <Grid ColumnDefinitions="84,*,Auto" ColumnSpacing="8">
              <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Power (W)" TextColor="{Binding Telemetry.PowerChartColor}" />
                <Label Text="{Binding Telemetry.CurrentPowerZoneText}" FontSize="11" TextColor="{StaticResource Muted}" />
              </VerticalStackLayout>
              <local:TelemetryChart Grid.Column="1" Points="{Binding Telemetry.PowerChartSamples}" ComparisonPoints="{Binding PreviousPowerChartSamples}" TimeRangeStart="{Binding ChartTimeRangeStart}" TimeRangeEnd="{Binding ChartTimeRangeEnd}" HoverTimestamp="{Binding ChartHoverTimestamp, Mode=TwoWay}" SelectionStart="{Binding ChartSelectionStart, Mode=TwoWay}" SelectionEnd="{Binding ChartSelectionEnd, Mode=TwoWay}" EventMarkers="{Binding SessionEvents}" ReferenceValues="{Binding Telemetry.PowerZoneTransitionValues}" MinimumValue="0" StrokeColor="{Binding Telemetry.PowerChartColor}" ValueLabelFormat="F0" HighContrast="{Binding Telemetry.UseHighContrastTelemetry}" ShowTimeAxis="False" />
              <Label Grid.Column="2" Text="{Binding Telemetry.PowerChartSummary}" IsVisible="{Binding Telemetry.ShowChartSummaries}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="84,*,Auto" ColumnSpacing="8">
              <Label Text="Speed" TextColor="{Binding Telemetry.SpeedChartColor}" VerticalOptions="Center" />
              <local:TelemetryChart Grid.Column="1" Points="{Binding Telemetry.SpeedChartSamples}" ComparisonPoints="{Binding PreviousSpeedChartSamples}" TimeRangeStart="{Binding ChartTimeRangeStart}" TimeRangeEnd="{Binding ChartTimeRangeEnd}" HoverTimestamp="{Binding ChartHoverTimestamp, Mode=TwoWay}" SelectionStart="{Binding ChartSelectionStart, Mode=TwoWay}" SelectionEnd="{Binding ChartSelectionEnd, Mode=TwoWay}" EventMarkers="{Binding SessionEvents}" MinimumValue="0" StrokeColor="{Binding Telemetry.SpeedChartColor}" ValueLabelFormat="F1" HighContrast="{Binding Telemetry.UseHighContrastTelemetry}" ShowTimeAxis="False" />
              <Label Grid.Column="2" Text="{Binding Telemetry.SpeedChartSummary}" IsVisible="{Binding Telemetry.ShowChartSummaries}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="84,*,Auto" ColumnSpacing="8">
              <Label Text="Cadence (rpm)" TextColor="{Binding Telemetry.CadenceChartColor}" VerticalOptions="Center" />
              <local:TelemetryChart Grid.Column="1" Points="{Binding Telemetry.CadenceChartSamples}" ComparisonPoints="{Binding PreviousCadenceChartSamples}" TimeRangeStart="{Binding ChartTimeRangeStart}" TimeRangeEnd="{Binding ChartTimeRangeEnd}" HoverTimestamp="{Binding ChartHoverTimestamp, Mode=TwoWay}" SelectionStart="{Binding ChartSelectionStart, Mode=TwoWay}" SelectionEnd="{Binding ChartSelectionEnd, Mode=TwoWay}" EventMarkers="{Binding SessionEvents}" MinimumValue="0" StrokeColor="{Binding Telemetry.CadenceChartColor}" ValueLabelFormat="F0" HighContrast="{Binding Telemetry.UseHighContrastTelemetry}" ShowTimeAxis="False" />
              <Label Grid.Column="2" Text="{Binding Telemetry.CadenceChartSummary}" IsVisible="{Binding Telemetry.ShowChartSummaries}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Row="3" ColumnDefinitions="84,*,Auto" ColumnSpacing="8">
              <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Heart rate" TextColor="{Binding HeartRate.ChartColor}" />
                <Label Text="{Binding HeartRate.CurrentZoneText}" FontSize="11" TextColor="{StaticResource Muted}" />
              </VerticalStackLayout>
              <local:TelemetryChart Grid.Column="1" Points="{Binding HeartRate.ChartSamples}" ComparisonPoints="{Binding PreviousHeartRateChartSamples}" BackgroundRegions="{Binding HeartRate.ChartBackgroundRegions}" TimeRangeStart="{Binding ChartTimeRangeStart}" TimeRangeEnd="{Binding ChartTimeRangeEnd}" HoverTimestamp="{Binding ChartHoverTimestamp, Mode=TwoWay}" SelectionStart="{Binding ChartSelectionStart, Mode=TwoWay}" SelectionEnd="{Binding ChartSelectionEnd, Mode=TwoWay}" EventMarkers="{Binding SessionEvents}" ReferenceValues="{Binding HeartRate.ZoneTransitionValues}" MinimumValue="60" StrokeColor="{Binding HeartRate.ChartColor}" ValueLabelFormat="F0" HighContrast="{Binding Telemetry.UseHighContrastTelemetry}" />
              <Label Grid.Column="2" Text="{Binding HeartRate.ChartSummary}" IsVisible="{Binding Telemetry.ShowChartSummaries}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Row="4" ColumnDefinitions="84,*,Auto" ColumnSpacing="8">
              <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Effort map" TextColor="{Binding Telemetry.PowerChartColor}" />
                <Label Text="Power vs cadence" FontSize="11" TextColor="{StaticResource Muted}" />
              </VerticalStackLayout>
              <local:PowerCadenceMap Grid.Column="1" Points="{Binding Telemetry.PowerCadenceSamples}" AccentColor="{Binding Telemetry.PowerChartColor}" HighContrast="{Binding Telemetry.UseHighContrastTelemetry}" />
              <Label Grid.Column="2" Text="{Binding Telemetry.PowerCadenceSummary}" IsVisible="{Binding Telemetry.ShowChartSummaries}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
          </Grid>
        </Grid>
      </Border>
      </Grid>
      </Grid>
    </ScrollView>
  </Grid>
</ContentPage>