<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Stationary.Ftms.Dashboard"
             xmlns:viewModels="clr-namespace:Stationary.Ftms.Dashboard.ViewModels"
             x:Class="Stationary.Ftms.Dashboard.SessionPage"
             x:DataType="viewModels:DashboardViewModel"
             Title="Session"
             BackgroundColor="{StaticResource Canvas}">
  <Grid x:Name="PageLayout">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1100" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter TargetName="ContentGrid" Property="ColumnDefinitions" Value="2*,3*" />
            <Setter TargetName="ContentGrid" Property="ColumnSpacing" Value="16" />
            <Setter TargetName="SessionHeader" Property="Grid.ColumnSpan" Value="2" />
            <Setter TargetName="SessionUnavailablePanel" Property="Grid.ColumnSpan" Value="2" />
            <Setter TargetName="TelemetryHistoryPanel" Property="Grid.Column" Value="1" />
            <Setter TargetName="TelemetryHistoryPanel" Property="Grid.Row" Value="2" />
            <Setter TargetName="TelemetryHistoryPanel" Property="Grid.RowSpan" Value="3" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <ScrollView>
      <Grid x:Name="ContentGrid" Padding="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
      <Grid x:Name="SessionHeader" ColumnDefinitions="*,Auto">
        <VerticalStackLayout Spacing="4">
          <Label Text="SESSION" FontAttributes="Bold" FontSize="30" />
          <Label Text="Workout totals and detailed telemetry" TextColor="{StaticResource Muted}" FontSize="14" />
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center" IsVisible="{Binding IsSessionAvailable}">
          <Button Text="Reset" TextColor="{StaticResource Accent}" Padding="4" Command="{Binding ResetSessionCommand}" SemanticProperties.Description="Reset locally tracked session totals" />
          <Button Text="Export CSV" TextColor="{StaticResource Accent}" Padding="4" Command="{Binding ExportSessionCommand}" SemanticProperties.Description="Export the local session summary as CSV" />
        </HorizontalStackLayout>
      </Grid>

      <Border x:Name="SessionUnavailablePanel" Grid.Row="1" Background="{StaticResource SurfaceSubtle}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="12,8" IsVisible="{Binding IsSessionUnavailable}">
        <Label Text="Connect a fitness machine or heart-rate sensor to begin a session." TextColor="{StaticResource Muted}" />
      </Border>

      <Border x:Name="SessionSummaryPanel" Grid.Row="2" Style="{StaticResource PanelBorder}" IsVisible="{Binding IsSessionAvailable}">
        <VerticalStackLayout Spacing="10">
          <Label Text="Session summary" FontAttributes="Bold" />
          <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start">
            <VerticalStackLayout Margin="0,0,24,0" Spacing="2">
              <Label Text="DISTANCE" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionDistanceText}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Margin="0,0,24,0" Spacing="2">
              <Label Text="ELAPSED" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionElapsedTimeText}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Margin="0,0,24,0" Spacing="2">
              <Label Text="ENERGY" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionEnergyText}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Margin="0,0,24,0" Spacing="2">
              <Label Text="AVERAGE POWER" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionAveragePowerText}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="2">
              <Label Text="AVERAGE SPEED" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding Telemetry.SessionAverageSpeedText}" FontAttributes="Bold" />
            </VerticalStackLayout>
          </FlexLayout>
        </VerticalStackLayout>
      </Border>

      <Border x:Name="HeartRatePanel" Grid.Row="3" Style="{StaticResource PanelBorder}" IsVisible="{Binding IsHeartRateConnected}">
        <VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
              <Label Text="External heart rate" FontAttributes="Bold" />
              <Label Text="{Binding HeartRate.HealthText}" FontSize="12" TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Label Grid.Column="1" Text="{Binding HeartRate.CurrentHeartRateText}" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
            <VerticalStackLayout Spacing="2">
              <Label Text="CURRENT ZONE" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding HeartRate.CurrentZoneText}" FontAttributes="Bold" />
              <Label Text="{Binding HeartRate.CurrentZoneRangeText}" FontSize="11" TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
              <Label Text="SESSION AVERAGE" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding HeartRate.SessionAverageText}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="2">
              <Label Text="SESSION MAXIMUM" FontSize="12" TextColor="{StaticResource Muted}" />
              <Label Text="{Binding HeartRate.SessionMaximumText}" FontAttributes="Bold" />
            </VerticalStackLayout>
          </Grid>
          <FlexLayout BindableLayout.ItemsSource="{Binding HeartRate.ZoneDurations}" Direction="Row" Wrap="Wrap" AlignItems="Start" IsVisible="{Binding HeartRate.IsZoneProfileConfigured}">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="viewModels:HeartRateZoneViewModel">
                <VerticalStackLayout Margin="0,0,20,4" Spacing="1">
                  <Label Text="{Binding Code}" TextColor="{StaticResource Muted}" FontSize="12">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Accent}" />
                        <Setter Property="FontAttributes" Value="Bold" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                  <Label Text="{Binding TimeInZoneText}" FontAttributes="Bold" />
                  <Label Text="{Binding RangeText}" TextColor="{StaticResource Muted}" FontSize="11" />
                </VerticalStackLayout>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>
        </VerticalStackLayout>
      </Border>

      <Border x:Name="TelemetryHistoryPanel" Grid.Row="4" Style="{StaticResource PanelBorder}" IsVisible="{Binding IsSessionAvailable}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <Label Text="Telemetry history" FontAttributes="Bold" />
          <Grid Grid.Row="1" RowDefinitions="*,*,*,*,112" RowSpacing="8" MinimumHeightRequest="420">
            <Grid ColumnDefinitions="84,*,Auto" ColumnSpacing="8">
              <Label Text="Power (W)" TextColor="{Binding Telemetry.PowerChartColor}" VerticalOptions="Center" />
              <local:TelemetryChart Grid.Column="1" Points="{Binding Telemetry.PowerChartSamples}" StrokeColor="{Binding Telemetry.PowerChartColor}" />
              <Label Grid.Column="2" Text="{Binding Telemetry.PowerChartSummary}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="84,*,Auto" ColumnSpacing="8">
              <Label Text="Speed" TextColor="{Binding Telemetry.SpeedChartColor}" VerticalOptions="Center" />
              <local:TelemetryChart Grid.Column="1" Points="{Binding Telemetry.SpeedChartSamples}" StrokeColor="{Binding Telemetry.SpeedChartColor}" />
              <Label Grid.Column="2" Text="{Binding Telemetry.SpeedChartSummary}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="84,*,Auto" ColumnSpacing="8">
              <Label Text="Cadence (rpm)" TextColor="{Binding Telemetry.CadenceChartColor}" VerticalOptions="Center" />
              <local:TelemetryChart Grid.Column="1" Points="{Binding Telemetry.CadenceChartSamples}" StrokeColor="{Binding Telemetry.CadenceChartColor}" />
              <Label Grid.Column="2" Text="{Binding Telemetry.CadenceChartSummary}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Row="3" ColumnDefinitions="84,*,Auto" ColumnSpacing="8">
              <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Heart rate" TextColor="{Binding HeartRate.ChartColor}" />
                <Label Text="{Binding HeartRate.CurrentZoneText}" FontSize="11" TextColor="{StaticResource Muted}" />
              </VerticalStackLayout>
              <local:TelemetryChart Grid.Column="1" Points="{Binding HeartRate.ChartSamples}" StrokeColor="{Binding HeartRate.ChartColor}" />
              <Label Grid.Column="2" Text="{Binding HeartRate.ChartSummary}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Row="4" ColumnDefinitions="84,*,Auto" ColumnSpacing="8">
              <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Effort map" TextColor="{Binding Telemetry.PowerChartColor}" />
                <Label Text="Power vs cadence" FontSize="11" TextColor="{StaticResource Muted}" />
              </VerticalStackLayout>
              <local:PowerCadenceMap Grid.Column="1" Points="{Binding Telemetry.PowerCadenceSamples}" AccentColor="{Binding Telemetry.PowerChartColor}" />
              <Label Grid.Column="2" Text="{Binding Telemetry.PowerCadenceSummary}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </Grid>
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="24">
            <FlexLayout BindableLayout.ItemsSource="{Binding Telemetry.Metrics}" Direction="Row" Wrap="Wrap" AlignItems="Start">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="local:TelemetryMetric">
                  <VerticalStackLayout Margin="0,0,24,12" Spacing="2">
                    <Label Text="{Binding Name}" TextColor="{StaticResource Muted}" FontSize="12" />
                    <Label Text="{Binding Value}" FontAttributes="Bold" />
                  </VerticalStackLayout>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </FlexLayout>
            <FlexLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding Telemetry.Insights}" Direction="Row" Wrap="Wrap" AlignItems="Start">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="local:TelemetryInsight">
                  <VerticalStackLayout Margin="0,0,24,8" Spacing="2">
                    <Label Text="{Binding Name}" TextColor="{StaticResource Muted}" FontSize="12" />
                    <Label Text="{Binding Value}" FontAttributes="Bold" />
                    <Label Text="{Binding Detail}" TextColor="{StaticResource Muted}" FontSize="11" />
                  </VerticalStackLayout>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </FlexLayout>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="DisplaySettingsPanel" Grid.Row="5" Style="{StaticResource PanelBorder}">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
          <VerticalStackLayout Spacing="4">
            <Label Text="Metric units" FontAttributes="Bold" />
            <Label Text="Speed and distance" FontSize="12" TextColor="{StaticResource Muted}" />
            <Switch IsToggled="{Binding Telemetry.UseMetricUnits, Mode=TwoWay}" OnColor="{StaticResource Accent}" HorizontalOptions="Start" />
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="1" Spacing="4">
            <Label Text="Large values" FontAttributes="Bold" />
            <Label Text="Increase Ride metrics" FontSize="12" TextColor="{StaticResource Muted}" />
            <Switch IsToggled="{Binding Telemetry.UseLargeTelemetryText, Mode=TwoWay}" OnColor="{StaticResource Accent}" HorizontalOptions="Start" />
          </VerticalStackLayout>
          <VerticalStackLayout Grid.Column="2" Spacing="4">
            <Label Text="High contrast" FontAttributes="Bold" />
            <Label Text="Chart color treatment" FontSize="12" TextColor="{StaticResource Muted}" />
            <Switch IsToggled="{Binding Telemetry.UseHighContrastTelemetry, Mode=TwoWay}" OnColor="{StaticResource Accent}" HorizontalOptions="Start" />
          </VerticalStackLayout>
        </Grid>
      </Border>
      </Grid>
    </ScrollView>
  </Grid>
</ContentPage>