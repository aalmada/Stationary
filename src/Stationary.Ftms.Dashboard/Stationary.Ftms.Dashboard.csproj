<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-maccatalyst</TargetFramework>
    <UseMaui>true</UseMaui>
    <MauiVersion>11.0.0-rc.2.26505.5</MauiVersion>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Stationary FTMS</ApplicationTitle>
    <ApplicationId>com.stationary.ftms.dashboard</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Stationary.Ble/Stationary.Ble.csproj" />
    <ProjectReference Include="../Stationary.Ftms.Client/Stationary.Ftms.Client.csproj" />
    <ProjectReference Include="../Stationary.Ftms.Dashboard.Core/Stationary.Ftms.Dashboard.Core.csproj" />
    <ProjectReference Include="../Stationary.Ftms.Dashboard.ViewModels/Stationary.Ftms.Dashboard.ViewModels.csproj" />
    <ProjectReference Include="../Stationary.HeartRate/Stationary.HeartRate.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Plugin.BLE" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="Silk.NET.MoltenVK.Native" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
  </ItemGroup>
  <ItemGroup>
    <!-- SPIR-V compiled from Shaders/scene.vert and scene.frag with glslangValidator; see AGENTS.md. -->
    <EmbeddedResource Include="Shaders/*.spv" LogicalName="%(Filename)%(Extension)" />
    <!-- Bind Silk.NET Vulkan calls to the statically linked MoltenVK instead of probing for a dynamic loader. -->
    <RuntimeHostConfigurationOption Include="SILK_NET_VULKAN_VK_ENABLE_PINVOKE_OVERRIDE_0" Value="true" Trim="true" />
  </ItemGroup>
</Project>