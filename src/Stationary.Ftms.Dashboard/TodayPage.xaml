<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:local="clr-namespace:Stationary.Ftms.Dashboard"
             xmlns:viewModels="clr-namespace:Stationary.Ftms.Dashboard.ViewModels;assembly=Stationary.Ftms.Dashboard.ViewModels"
             x:Class="Stationary.Ftms.Dashboard.TodayPage"
             x:DataType="viewModels:DashboardViewModel"
             Title="Home"
             BackgroundColor="{StaticResource Canvas}">
  <ContentPage.Resources>
    <local:TrainingDurationTextConverter x:Key="TrainingDurationTextConverter" />
    <Style x:Key="ReadinessDot" TargetType="BoxView">
      <Setter Property="WidthRequest" Value="10" />
      <Setter Property="HeightRequest" Value="10" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="Color" Value="#C5A23C" />
    </Style>
  </ContentPage.Resources>
  <ScrollView>
    <VerticalStackLayout Padding="28,24" Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <VerticalStackLayout Spacing="2">
          <Label Text="Ready to ride" FontAttributes="Bold" FontSize="30" />
          <Label Text="Pick how you want to ride. The live dashboard opens the moment you start." TextColor="{StaticResource Muted}" FontSize="14" />
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
          <Button Style="{StaticResource SecondaryActionButton}" Text="Results" Command="{Binding ShowResultsCommand}" />
          <Button Style="{StaticResource SecondaryActionButton}" Text="Settings" Command="{Binding ShowSettingsCommand}" />
        </HorizontalStackLayout>
      </Grid>

      <Border Style="{StaticResource PanelBorder}" Background="{StaticResource HeroBrush}" Stroke="{StaticResource HeroSurface}" IsVisible="{Binding IsRideInProgress}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <VerticalStackLayout Spacing="2">
            <Label Text="RIDE IN PROGRESS" TextColor="{StaticResource HeroMuted}" FontSize="11" FontAttributes="Bold" />
            <Label Text="{Binding RideTitle}" TextColor="{StaticResource HeroInk}" FontAttributes="Bold" FontSize="20" />
            <Label TextColor="{StaticResource HeroMuted}">
              <Label.FormattedText>
                <FormattedString>
                  <Span Text="{Binding Telemetry.PowerText}" />
                  <Span Text="  ·  " />
                  <Span Text="{Binding Telemetry.SessionElapsedTimeText}" />
                </FormattedString>
              </Label.FormattedText>
            </Label>
          </VerticalStackLayout>
          <Button Grid.Column="1" Style="{StaticResource ActionButton}" Text="Return to ride" Command="{Binding ShowRideCommand}" VerticalOptions="Center" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
        <Border Style="{StaticResource PanelBorder}">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <VerticalStackLayout Spacing="4">
              <Label Text="FREE RIDE" Style="{StaticResource TileCaption}" />
              <Label Text="Just ride" FontAttributes="Bold" FontSize="20" />
              <Label Text="Live power, heart-rate, cadence, and speed charts. Set ERG power or resistance from the dashboard whenever the machine supports it." TextColor="{StaticResource Muted}" FontSize="12" />
            </VerticalStackLayout>
            <Label Grid.Row="1" Text="Connect a fitness machine or heart-rate sensor first." FontAttributes="Bold" FontSize="12" VerticalOptions="End" IsVisible="{Binding IsSessionUnavailable}" />
            <Button Grid.Row="2" Style="{StaticResource ActionButton}" Text="Start free ride" Command="{Binding StartFreeRideCommand}" SemanticProperties.Description="Open the live dashboard and start a free ride" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <VerticalStackLayout Spacing="4">
              <Label Text="WORKOUT" Style="{StaticResource TileCaption}" />
              <Label Text="{Binding Training.SelectedWorkout.Name}" FontAttributes="Bold" FontSize="20" LineBreakMode="TailTruncation" />
              <Label Text="{Binding Training.SelectedWorkout.TotalDuration, Converter={StaticResource TrainingDurationTextConverter}}" TextColor="{StaticResource Muted}" FontSize="12" />
            </VerticalStackLayout>
            <local:TrainingProfileView Grid.Row="1" Segments="{Binding Training.SelectedWorkout.Segments}" HeightRequest="52" />
            <Label Grid.Row="2" Text="{Binding Training.StatusText}" TextColor="{StaticResource Muted}" FontSize="12" />
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Style="{StaticResource ActionButton}" Text="Start workout" Command="{Binding Training.StartCommand}" SemanticProperties.Description="Start the selected workout in ERG mode" />
              <Button Grid.Column="1" Style="{StaticResource SecondaryActionButton}" Text="Change" Command="{Binding ShowTrainingCommand}" SemanticProperties.Description="Browse workouts and training plans" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <VerticalStackLayout Spacing="4">
              <Label Text="FTP TEST" Style="{StaticResource TileCaption}" />
              <Label Text="Ramp test" FontAttributes="Bold" FontSize="20" />
              <Label Text="Five easy minutes, then one-minute steps until you cannot hold the target. The estimate updates your zones and workout targets." TextColor="{StaticResource Muted}" FontSize="12" />
              <Label Text="{Binding Training.RampEstimateText}" FontAttributes="Bold" FontSize="12" />
            </VerticalStackLayout>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Style="{StaticResource ActionButton}" Text="Start ramp test" Command="{Binding Training.StartRampTestCommand}" />
              <Button Grid.Column="1" Style="{StaticResource SecondaryActionButton}" Text="Accept FTP" Command="{Binding Training.AcceptRampEstimateCommand}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Style="{StaticResource PanelBorder}">
        <VerticalStackLayout Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
              <Label Text="BEFORE YOU RIDE" Style="{StaticResource TileCaption}" />
              <Label Text="{Binding WorkoutReadinessText}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsWorking}" IsVisible="{Binding IsWorking}" Color="{StaticResource Accent}" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <BoxView Style="{StaticResource ReadinessDot}">
                <BoxView.Triggers>
                  <DataTrigger TargetType="BoxView" Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Color" Value="{StaticResource Accent}" />
                  </DataTrigger>
                </BoxView.Triggers>
              </BoxView>
              <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="{Binding MachineChipText}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                <Label Text="{Binding MachineChipDetail}" Style="{StaticResource TileDetail}" />
              </VerticalStackLayout>
              <Button Grid.Column="2" Style="{StaticResource SecondaryActionButton}" Text="Pair" Command="{Binding ShowSensorsCommand}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <BoxView Style="{StaticResource ReadinessDot}" Color="{StaticResource Line}">
                <BoxView.Triggers>
                  <DataTrigger TargetType="BoxView" Binding="{Binding IsHeartRateConnected}" Value="True">
                    <Setter Property="Color" Value="{StaticResource Accent}" />
                  </DataTrigger>
                </BoxView.Triggers>
              </BoxView>
              <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="{Binding HeartRateChipText}" FontAttributes="Bold" />
                <Label Text="{Binding HeartRateChipDetail}" Style="{StaticResource TileDetail}" />
              </VerticalStackLayout>
              <Button Grid.Column="2" Style="{StaticResource SecondaryActionButton}" Text="Pair" Command="{Binding ShowHeartRateSensorCommand}" VerticalOptions="Center" />
            </Grid>
            <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <BoxView Style="{StaticResource ReadinessDot}">
                <BoxView.Triggers>
                  <DataTrigger TargetType="BoxView" Binding="{Binding IsFtpSet}" Value="True">
                    <Setter Property="Color" Value="{StaticResource Accent}" />
                  </DataTrigger>
                </BoxView.Triggers>
              </BoxView>
              <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="{Binding FtpChipText}" FontAttributes="Bold" />
                <Label Text="Functional threshold power" Style="{StaticResource TileDetail}" />
              </VerticalStackLayout>
              <Button Grid.Column="2" Style="{StaticResource SecondaryActionButton}" Text="Settings" Command="{Binding ShowSettingsCommand}" VerticalOptions="Center" />
            </Grid>
          </Grid>
          <Label Text="{Binding StatusText}" Style="{StaticResource TileDetail}" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource PanelBorder}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <VerticalStackLayout Spacing="2">
            <Label Text="LAST RIDE" Style="{StaticResource TileCaption}" />
            <Label Text="{Binding PreviousSessionComparisonText}" TextColor="{StaticResource Muted}" FontSize="12" />
          </VerticalStackLayout>
          <Button Grid.Column="1" Style="{StaticResource SecondaryActionButton}" Text="Review results" Command="{Binding ShowResultsCommand}" VerticalOptions="Center" />
        </Grid>
      </Border>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
